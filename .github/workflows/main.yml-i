name: Build APK from ZIP (Titanium Edition)

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle (with Caching)
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.5

      - name: Smart Unzip and Prepare
        run: |
          echo "🔍 Searching for ZIP file..."
          
          ZIP_FILE=$(find . -maxdepth 2 -name "*.zip" | head -n 1)
          
          if [ -z "$ZIP_FILE" ]; then
            echo "❌ Error: No ZIP file found! Please upload your project ZIP."
            exit 1
          fi
          
          echo "📦 FOUND ZIP: $ZIP_FILE"
          unzip -q "$ZIP_FILE" -d project_root
          cd project_root
          
          PROJECT_ROOT_DIR=$(find . -name "build.gradle.kts" -o -name "build.gradle" | head -n 1 | xargs dirname)
          
          if [ -z "$PROJECT_DIR" ]; then
            echo "❌ Error: Could not find Android project files (build.gradle)."
            exit 1
          fi
          
          echo "📁 PROJECT_ROOT_DIR found at: $PROJECT_DIR"
          echo "PROJECT_DIR=$PROJECT_DIR" >> $GITHUB_ENV
          echo "Project root found at: $PROJECT_DIR"

      - name: Generate Gradle Wrapper & Build
        run: |
          cd project_root/$PROJECT_DIR
          
          if [ ! -f "gradlew" ]; then
            echo "⚠️ gradlew missing! Generating..."
            gradle wrapper
          fi
          
          chmod +x gradlew
          
          echo "🚀 Starting Build..."
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Pubg-Booster-APK
          path: project_root/$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
